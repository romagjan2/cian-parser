# Copy to ~/.config/cian-parser/.env — never commit real values.
POSTGRES_USER=cian
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cian
POSTGRES_PORT=5434
DATABASE_URL=postgresql://cian:change-me@localhost:5434/cian
HEADLESS=false
REQUEST_DELAY_SECONDS=2.0
MAX_PAGES=40
PLAYWRIGHT_STORAGE_STATE=/home/YOU/.config/cian-parser/cian_auth.json
